#
# flutter run --dart-define=EPDK_STATIONS_URL=https://apigateway.epdk.gov.tr/sarjIstasyonlari --dart-define=OVERPASS_URL=https://overpass-api.de/api/interpreter

EPDK_STATIONS_URL=https://apigateway.epdk.gov.tr/sarjIstasyonlari
OVERPASS_URL=https://overpass-api.de/api/interpreter

