#!/bin/sh
# Gizli dosya ve anahtar izini commit'e almayı reddeder.
# Kurulum: .git/hooks/pre-commit dosyasına kopyala. git config değiştirilmez.

files=$(git diff --cached --name-only --diff-filter=ACM)
blocked=$(printf '%s\n' "$files" | grep -E '(^|/)\.env$|(^|/)\.env\.[^/]*$|google-services\.json|GoogleService-Info\.plist|key\.properties|\.jks$|\.keystore$|serviceAccount|service-account|firebase-adminsdk' | grep -v '\.env\.example$' || true)
if [ -n "$blocked" ]; then
  echo "Gizli dosya commit'e alınamaz:"
  printf '%s\n' "$blocked"
  exit 1
fi

if git diff --cached -U0 -- . ':(exclude).githooks/pre-commit' | grep -E '-----BEGIN ((RSA|OPENSSH|EC) )?PRIVATE KEY-----|sk-ant-|AKIA[0-9A-Z]{16}'; then
  echo "Commit içinde gizli anahtar izi var."
  exit 1
fi

exit 0
